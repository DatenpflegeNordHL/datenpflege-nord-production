    check) [ "$#" -eq 3 ] && [ "$2" = --target ] || usage; TARGET="$3" ;;
    authorize|deploy)
        [ "$#" -eq 5 ] && [ "$2" = --target ] && [ "$4" = --release-tag ] || usage
        TARGET="$3"; RELEASE_TAG="$5"
        [[ "$RELEASE_TAG" =~ ^dpn-release-[0-9]{8}-[0-9]{6}Z$ ]] || usage
